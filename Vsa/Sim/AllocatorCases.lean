/-- Equality and inequality discharge their source binary branches. -/
theorem Residuals.binary {aux : AuxMotives} (R : Residuals aux) :
    ∀ (st : SpecSt) (d : Nat) (env : Addr) (op : BinOp) (l r : Expr) (st' st'' : SpecSt) (lv rv v : Value) (a : EvalE st d env l st' lv) (a_1 : EvalE st' d env r st'' rv) (a_2 : binOpSem st''.store op lv rv = some v),
      mEvalE st d env l st' lv a →
      mEvalE st' d env r st'' rv a_1 →
      mEvalE st d env (Expr.binary op l r) st'' v (EvalE.binary st d env op l r st' st'' lv rv v a a_1 a_2) := by
  intro st d env op l r st' st'' lv rv v a a_1 a_2 left right
  by_cases heq : op = .eq
  · subst op
    exact EvalAllocatorSupply.binary_eqne .eq a a_1 a_2 left right
  by_cases hne : op = .ne
  · subst op
    exact EvalAllocatorSupply.binary_eqne .ne a a_1 a_2 left right
  exact R.hBinaryOther st d env op l r st' st'' lv rv v a a_1 a_2 heq hne left right

/-- Checked proofs supply the source constructor for every physical sequence copy. -/
theorem seqConsNormal :
    ∀ (st : SpecSt) (d : Nat) (env : Addr) (s : Stmt) (ss : List Stmt) (st' st'' : SpecSt) (status : Status) (a : ExecS st d env s st' Status.normal) (a_1 : ExecSeq st' d env ss st'' status),
      mExecS st d env s st' Status.normal a →
      mExecSeq st' d env ss st'' status a_1 →
      mExecSeq st d env (s :: ss) st'' status (ExecSeq.consNormal st d env s ss st' st'' status a a_1) := by
  intro st d env s ss st' st'' status a a_1 head tail copy
  cases copy with
  | closureBody => exact ExecSeqAllocatorSupply.closure_consNormal a a_1 head (tail .closureBody)
  | interpRun => exact ExecSeqAllocatorSupply.interp_consNormal a a_1 head (tail .interpRun)
  | blockBody => exact ExecSeqAllocatorSupply.block_consNormal a a_1 head (tail .blockBody)

/-- Checked proofs supply the source constructor for every physical sequence copy. -/
theorem seqConsAbrupt :
    ∀ (st : SpecSt) (d : Nat) (env : Addr) (s : Stmt) (ss : List Stmt) (st' : SpecSt) (status : Status) (a : ExecS st d env s st' status) (a_1 : status ≠ Status.normal),
      mExecS st d env s st' status a →
      mExecSeq st d env (s :: ss) st' status (ExecSeq.consAbrupt st d env s ss st' status a a_1) := by
  intro st d env s ss st' status a a_1 head copy
  cases copy with
  | closureBody => exact ExecSeqAllocatorSupply.closure_consAbrupt a_1 head
  | interpRun => exact ExecSeqAllocatorSupply.interp_consAbrupt a_1
  | blockBody => exact ExecSeqAllocatorSupply.block_consAbrupt a_1 head

