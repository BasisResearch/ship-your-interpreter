    (hstack : ∀ k, Vsa.Sim.LayoutInstance.stackSL.lo ≤ k →
      k < Vsa.Sim.LayoutInstance.stackSL.hi → ∃ b : BitVec 8, (bootMem script log)[k]? = some b)
