/-! ## The jal seam is Shape-D, FRAMED (`bridgeOfSegFramed`)

The `driveSpill` body ends in `jal setjmp` (a CALL — deliberately outside `TKind`),
BUT the span's prologue `addi sp,sp,-176` reseats `sp` (`x2`), a callee-saved
register.  So `WrChainAvoidAbi driveSpillSeg` is FALSE and plain `bridgeOfSeg` does
not apply (genseg emitted it by default — see observations `genseg-jal-sp-reseat`).
This is the `BridgeSegFramed` demo (a) idiom (the closure `mv s7`/`mv s5` reseats):
we bridge with `P := AbiExceptSp` (`AbiPreserved && !(R == x2)`), asserting the ABI
frame for every callee-saved EXCEPT `sp`, and reading the new `sp = sp - 176` off
the EXPOSED post bundle `GHolds σ2 out.regs` (the delta, free from the seg).  The
jal seam's `JalStep` stays a NAMED region-specific residual `hjalSeam`. -/

/-- The restricted ABI frame predicate: callee-saved EXCEPT the reseated `sp = x2`.
`bridgeOfSegFramed`'s frame conclusion holds for exactly these; `sp`'s new value
(`sp - 176`) is read off the exposed post bundle instead. -/
def AbiExceptSp (R : Register) : Bool := Vsa.Alloc.AbiPreserved R && !(R == Register.x2)

/-- **`driveSpillBridge`** — the `driveSpill` body ≫ `jal setjmp` bridge, via
`bridgeOfSegFramed`.  The seg run + the `P := AbiExceptSp` callee-saved frame are
FREE; `hfacts` (the memory chain-facts) and `hjalSeam` (the call-seam `JalStep` off
the callee `site_*` obs) are the only region-specific residuals.  Conclusion:
parked at the callee entry `0x80006ffc#64` (setjmp) with link `0x80004428#64`,
memory = the seg write-log, the whole reseated register bundle EXPOSED (incl. the
new `sp`), and the ABI frame for every callee-saved except `sp`. -/
theorem driveSpillBridge
    (σ : MState) (i u : Nat) (vminstret : BitVec 64) (a0 : BitVec 64) (sp : BitVec 64) (ra : BitVec 64) (s0 : BitVec 64) (s1 : BitVec 64) (s2 : BitVec 64) (s3 : BitVec 64) (s4 : BitVec 64) (s5 : BitVec 64) (s6 : BitVec 64) (a1 : BitVec 64) (a2 : BitVec 64) (a3 : BitVec 64)
    (m0 : Std.ExtHashMap Nat (BitVec 8))
    (hG : GoodState σ)
    (hpc : σ.regs.get? Register.PC = some (0x800043ec#64 : BitVec 64))
    (hminstret : σ.regs.get? Register.minstret = some vminstret)
    (hmem : σ.mem = m0)
    (hL : GHolds σ (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3))
    (hfacts : ChainFacts σ.mem σ.mem (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [] driveSpillSeg)
    (hi : i < 2)
    (hKeysOut : KeysOK (keysG (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).regs))
    (hRaOut : KeysAvoidRa (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).regs)
    (hjalSeam : ∀ (σ' : MState) (i' u' : Nat),
      GoodState σ' → i' < 2 →
      σ'.regs.get? Register.PC = some
        (evalBlocksPC 0x800043ec#64 (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) []) driveSpillSeg) →
      (∃ w, σ'.regs.get? Register.minstret = some w) →
      σ'.mem = writeLog m0 (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).log →
      GHolds σ' (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).regs →
      JalStep 0x80006ffc#64 0x80004428#64 σ' i' u') :
    ∃ (σ2 : MState) (i2 : Nat),
      Steps ⟨σ, i, u⟩ ⟨σ2, i2, u + evalBlocksFuel driveSpillSeg + 1⟩ ∧ i2 < 2 ∧ GoodState σ2 ∧
      σ2.regs.get? Register.PC = some (0x80006ffc#64 : BitVec 64) ∧
      σ2.regs.get? Register.x1 = some (0x80004428#64 : BitVec 64) ∧
      (∃ w, σ2.regs.get? Register.minstret = some w) ∧
      GHolds σ2 (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).regs ∧
      σ2.mem = writeLog m0 (evalBlocks driveSpillSeg (SegEvalState.init (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) [])).log ∧
      (∀ R, AbiExceptSp R = true → σ2.regs.get? R = σ.regs.get? R) := by
  have hkeys : KeysOK (keysG (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3)) := by
    have h : keysG (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) = [10, 2, 1, 8, 9, 18, 19, 20, 21, 22, 11, 12, 13] := rfl
    rw [h]; decide
  have hwf : ChainOK 0x800043ec#64 (keysG (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3)) driveSpillSeg := by
    have h : keysG (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) = [10, 2, 1, 8, 9, 18, 19, 20, 21, 22, 11, 12, 13] := rfl
    rw [h]; show ChainOK 0x800043ec#64 [10, 2, 1, 8, 9, 18, 19, 20, 21, 22, 11, 12, 13] driveSpillSeg; decide
  have hnoiseP : ∀ rr ∈ noiseRegs, AbiExceptSp rr = false := by decide
  have hAvoidP : WrChainAvoids AbiExceptSp driveSpillSeg := by decide
  have hPabi : ∀ R, AbiExceptSp R = true → Vsa.Alloc.AbiPreserved R = true := by
    intro R hR; unfold AbiExceptSp at hR; exact (Bool.and_eq_true .. |>.mp hR).1
  exact bridgeOfSegFramed AbiExceptSp driveSpillSeg (driveSpillL a0 sp ra s0 s1 s2 s3 s4 s5 s6 a1 a2 a3) []
    σ i u (0x800043ec#64) (0x80006ffc#64) (0x80004428#64) vminstret m0
    hG hpc hminstret hmem hL hkeys hfacts hi hwf
    hnoiseP hAvoidP hKeysOut hRaOut hPabi hjalSeam

