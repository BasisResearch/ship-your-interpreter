namespace Vsa.Sim.Rows

local notation "SpecSt" => Vsa.While.St

/-- The brk-case residual: the `ExecCaseGeom` bundle, ∀-closed over the ghosts. -/
def BrkResid (st : SpecSt) : Prop :=
  ∀ (g : (R : Register) → Option (RegisterType R))
    (N : NativeAddrs) (A : Arena) (SL : StackLayout) (φf φc : Addr → Nat)
    (d : Nat) (env : Addr) (sp r aInterp aStmt aEnv aRet : BitVec 64) (m0 : Mem)
    (c : Config),
    Vsa.Sim.ExecEntry g N A SL φf φc st d env .brk sp r aInterp aStmt aEnv aRet m0 c →
    Vsa.Sim.ExecCaseGeom g N A SL φf φc st .brk 7 Vsa.Sim.execArmBrk sp r aRet m0

/-- Route `hSBrk` → `execBrkSimD`. -/
theorem exec_brk_row (hR : ∀ st, BrkResid st) :
    ∀ (st : SpecSt) (d : Nat) (env : Addr),
      mExecS st d env Stmt.brk st Status.brk (ExecS.brk st d env) := by
  intro st d env
  show Vsa.Sim.ExecIH st d env .brk st .brk
  intro g N A SL φf φc sp r aInterp aStmt aEnv aRet m0
  intro c hEntry
  exact Vsa.Sim.execBrkSimD g N A SL φf φc st d env sp r aInterp aStmt aEnv aRet m0
    (ExecS.brk st d env)
    (hR st g N A SL φf φc d env sp r aInterp aStmt aEnv aRet m0 c hEntry) c hEntry

/-- The cont-case residual: the `ExecCaseGeom` bundle, ∀-closed over the ghosts. -/
def ContResid (st : SpecSt) : Prop :=
  ∀ (g : (R : Register) → Option (RegisterType R))
    (N : NativeAddrs) (A : Arena) (SL : StackLayout) (φf φc : Addr → Nat)
    (d : Nat) (env : Addr) (sp r aInterp aStmt aEnv aRet : BitVec 64) (m0 : Mem)
    (c : Config),
    Vsa.Sim.ExecEntry g N A SL φf φc st d env .cont sp r aInterp aStmt aEnv aRet m0 c →
    Vsa.Sim.ExecCaseGeom g N A SL φf φc st .cont 8 Vsa.Sim.execArmCont sp r aRet m0

/-- Route `hSCont` → `execContSimD`. -/
theorem exec_cont_row (hR : ∀ st, ContResid st) :
    ∀ (st : SpecSt) (d : Nat) (env : Addr),
      mExecS st d env Stmt.cont st Status.cont (ExecS.cont st d env) := by
  intro st d env
  show Vsa.Sim.ExecIH st d env .cont st .cont
  intro g N A SL φf φc sp r aInterp aStmt aEnv aRet m0
  intro c hEntry
  exact Vsa.Sim.execContSimD g N A SL φf φc st d env sp r aInterp aStmt aEnv aRet m0
    (ExecS.cont st d env)
    (hR st g N A SL φf φc d env sp r aInterp aStmt aEnv aRet m0 c hEntry) c hEntry

end Vsa.Sim.Rows
