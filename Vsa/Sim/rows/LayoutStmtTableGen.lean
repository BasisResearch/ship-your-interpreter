/-- `ST_EXPR` (tag 0) exec_stmt jump-table slot @ `0x80019fb8`:
bytes `b8 a1 fe ff` (LE offset) → arm PC `0x80004170` = `stmtJumpTableBase + (Int32)`.
Read from the ELF `.rodata` at generation time; the sign-extended reassembly is
machine-checked by `decide`. -/
theorem groundStmtSlot_0 {m : Mem}
    (h0 : m[(stmtJumpTableBase + 4 * 0 + 0 : Nat)]? = some (0xb8 : BitVec 8))
    (h1 : m[(stmtJumpTableBase + 4 * 0 + 1 : Nat)]? = some (0xa1 : BitVec 8))
    (h2 : m[(stmtJumpTableBase + 4 * 0 + 2 : Nat)]? = some (0xfe : BitVec 8))
    (h3 : m[(stmtJumpTableBase + 4 * 0 + 3 : Nat)]? = some (0xff : BitVec 8)) :
    StmtSlotPinned 0 (0x80004170#64) m :=
  ⟨⟨0xb8#8, 0xa1#8, 0xfe#8, 0xff#8, h0, h1, h2, h3, by
    apply BitVec.eq_of_toNat_eq; simp only [stmtJumpTableBase]; decide⟩⟩

#print axioms groundStmtSlot_0

