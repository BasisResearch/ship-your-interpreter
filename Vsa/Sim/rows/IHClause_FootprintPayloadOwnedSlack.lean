    (fun st d env x e st' v store'' a a_1 ih_1 =>
      have hOld := B.hAssign st d env x e st' v store'' a a_1 ih_1.1
      And.intro hOld (R.hAssign st d env x e st' v store'' a a_1 ih_1.1 hOld ih_1.2))
    (fun st d env op l r st' st'' lv rv v a a_1 a_2 ih_1 ih_2 =>
