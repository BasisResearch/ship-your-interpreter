    (fun st d env s st' status h => Vsa.Sim.TermSimAssembly.mExecS st d env s st' status h ∧ mExecS st d env s st' status h)
    (fun st d env init st' h => Vsa.Sim.TermSimAssembly.mExecInit st d env init st' h ∧ mExecInit st d env init st' h)
    (fun st d env cnd step b st' status h => Vsa.Sim.TermSimAssembly.mForLoop st d env cnd step b st' status h ∧ mForLoop st d env cnd step b st' status h)
    (fun st d env cnd st' h => Vsa.Sim.TermSimAssembly.mForCond st d env cnd st' h ∧ mForCond st d env cnd st' h)
    (fun st d env step st' h => Vsa.Sim.TermSimAssembly.mExecStep st d env step st' h ∧ mExecStep st d env step st' h)
    (fun st d env ss st' status h => Vsa.Sim.TermSimAssembly.mExecSeq st d env ss st' status h ∧ mExecSeq st d env ss st' status h)
    (fun st d env n =>
      have hOld := B.hInt st d env n
      And.intro hOld (R.hInt st d env n hOld))
    (fun st d env s =>
      have hOld := B.hStr st d env s
      And.intro hOld (R.hStr st d env s hOld))
    (fun st d env b =>
      have hOld := B.hBool st d env b
      And.intro hOld (R.hBool st d env b hOld))
    (fun st d env =>
      have hOld := B.hNull st d env
      And.intro hOld (R.hNull st d env hOld))
    (fun st d env x v a =>
      have hOld := B.hVar st d env x v a
