    (fun st d env l r st' lv a a_1 ih_1 =>
      have hOld := B.hAndFalse st d env l r st' lv a a_1 ih_1.1
      And.intro hOld (R.hAndFalse st d env l r st' lv a a_1 ih_1.1 hOld ih_1.2))
    (fun st d env l r st' st'' lv rv a a_1 a_2 ih_1 ih_2 =>
