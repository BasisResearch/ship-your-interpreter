def extraM : EvalExtraM := fun N A SL φf φc _ sret _ => extra N A SL φf φc sret.toNat

/-- Embed an `EvalIHWith extra` fact into the clause motive. -/
theorem ofWith {st st' : SpecSt} {d env : Nat} {e : Expr} {v : Value}
