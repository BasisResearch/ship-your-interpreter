theorem setup80003f58_x10 (inp x18v : BitVec 64) (lds : List (List (BitVec 8))) :
    lookupG 10 (evalBlocks setup80003f58Seg (SegEvalState.init [(18, x18v)] lds)).regs
      = some x18v := by
  rw [evalBlocks_regs]
  show lookupG 10 (runGM
      ([mkLine 0x80003f3c#64 0x00050713#32, mkLine 0x80003f40#64 0x00040593#32] ++ mkLine 0x80003f44#64 0x00090513#32 ::
        [mkLine 0x80003f48#64 0x00015697#32, mkLine 0x80003f4c#64 0x4d868693#32, mkLine 0x80003f50#64 0x00015617#32, mkLine 0x80003f54#64 0x4a060613#32])
      [(18, x18v)] lds) = some x18v
  rw [lookupG_runGM_mid [mkLine 0x80003f3c#64 0x00050713#32, mkLine 0x80003f40#64 0x00040593#32]
      (mkLine 0x80003f44#64 0x00090513#32) [mkLine 0x80003f48#64 0x00015697#32, mkLine 0x80003f4c#64 0x4d868693#32, mkLine 0x80003f50#64 0x00015617#32, mkLine 0x80003f54#64 0x4a060613#32]
      [(18, x18v)] lds (by decide) 10 (by decide) (by decide)]
  show some (srcVal 18 (runGM [mkLine 0x80003f3c#64 0x00050713#32, mkLine 0x80003f40#64 0x00040593#32] [(18, x18v)] lds)
      + Functions.sign_extend 0#12) = some x18v
  rw [srcVal_runGM_ne 18 [mkLine 0x80003f3c#64 0x00050713#32, mkLine 0x80003f40#64 0x00040593#32] (by decide) [(18, x18v)] lds]
  show some (srcVal 18 [(18, x18v)] + Functions.sign_extend 0#12) = some x18v
  rw [show (Functions.sign_extend 0#12 : BitVec 64) = 0#64 from by decide, BitVec.add_zero]
  rfl
