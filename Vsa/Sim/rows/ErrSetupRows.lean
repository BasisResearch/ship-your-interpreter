/-- `hCallC` arm-branch marshalling → `ErrHalts c` (Family B; arm `hlink` is the named M4 residual). -/
theorem hCallC_hsite_of_armBranch (S : ErrShared)
    {ArmBranchPre : Config → Prop}
    (seg : Triple ArmBranchPre
      (JalErrPre S.g S.inp S.m0 0x80003f58#64 0xef#8 0xe0#8 0x1f#8 0xe5#8))
    (hlink : ∀ (c : Config) (st : SpecSt) (d : Nat) (env : Addr) (f : Expr) (args : List Expr)
      (st' st'' : SpecSt) (fv : Value) (vs : List Value),
      EvalE st d env f st' fv → EvalArgs st' d env args st'' vs →
      CallErr st'' d fv vs → ErrHalts c → ArmBranchPre c) :
    ∀ (c : Config) (st : SpecSt) (d : Nat) (env : Addr) (f : Expr) (args : List Expr)
      (st' st'' : SpecSt) (fv : Value) (vs : List Value),
      EvalE st d env f st' fv → EvalArgs st' d env args st'' vs →
      CallErr st'' d fv vs → ErrHalts c → ErrHalts c :=
  route_hCallC S
    (fun c a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 =>
      reachJal_of_armBranch S 0x80003f58#64 0xef#8 0xe0#8 0x1f#8 0xe5#8 seg c
        (hlink c a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13))
