import Vsa.Sim.DeriveCaseRow
import Vsa.Sim.DeriveMeta

/-!
# `DeriveRow` — `#derive_row`, the in-language segToTriple row emitter (L3)

`segToTriple` (`DeriveCaseRow.lean`) is the seg→`Triple` marshalling combinator:
from `SegPre bs L lds pc0 m0` + the row's one kernel `decide` (`hwf`) + a
caller-supplied `hpost` that reads the computed outcome, it produces
`Triple (SegPre …) Q`.  The scripted `genseg`/`gen_*_row.py` generators emit that
application as text; `#derive_row` is its **in-language twin** — it elaborates the
row theorem directly from a seg name + entry/pin data + a post predicate.

```
#derive_row <name> seg <segName> pins <L> lds <lds> entry <pc0> mem <m0> post <Q>
```

emits

```
theorem <name> (hpost : HpostFor <segName> <L> <lds> <pc0> <m0> <Q>) :
    Triple (SegPre <segName> <L> <lds> <pc0> <m0>) <Q> :=
  segToTriple <segName> <L> <lds> <pc0> <m0> <Q> (by decide) hpost
```

## What is mechanized vs. what remains a premise (honest)

`segToTriple` already discharged the *whole* seg-running + existential-packaging
half ONCE.  The row's TWO genuine inputs are:

* `hwf : ChainOK pc0 (keysG L) bs` — the structural VC.  `#derive_row` fills this
  with `by decide` (ONE kernel decide, per the fast-reflection law): mechanical.
* `hpost` — the caller's projection of *this case's* `SubEvalReturn`/`PreEpilogueV`
  post off the computed outcome.  This is the point-of-variation of a row and is
  NOT mechanizable across cases; `#derive_row` exposes it as a NAMED premise
  (`HpostFor …`, doc-carrying), exactly as `TermResiduals` names each row's
  residual.  So `#derive_row` lands the *marshalling skeleton* of a row with its
  one semantic obligation named — the honest in-language row.

NO `sorry`/`axiom`/`native_decide`/`bv_decide`; no Mathlib.
-/

open Lean Elab Command
open LeanRV64DExecutable Vsa
open Vsa.Machine (MState Config)
open Vsa.Logic (Triple)

namespace Vsa.Sim

/-- The `hpost` premise type of `segToTriple` for a fixed seg/pins/entry/post —
the row's ONE named semantic obligation (project this case's post off the
computed outcome).  Named so `#derive_row` can state it and consumers discharge
it, mirroring `TermResiduals`' per-row residual fields. -/
def HpostFor (bs : List BBlock) (L : GRegs) (lds : List (List (BitVec 8)))
    (pc0 : BitVec 64) (m0 : Std.ExtHashMap Nat (BitVec 8)) (Q : Config → Prop) : Prop :=
  ∀ (σ' : MState) (i' u' : Nat),
    GoodState σ' → i' < 2 →
    σ'.mem = writeLog m0 (evalBlocks bs (SegEvalState.init L lds)).log →
    σ'.regs.get? Register.PC = some (evalBlocksPC pc0 (SegEvalState.init L lds) bs) →
    (∃ w, σ'.regs.get? Register.minstret = some w) →
    GHolds σ' (evalBlocks bs (SegEvalState.init L lds)).regs →
    Q ⟨σ', i', u'⟩

/-- `segToTriple` restated through `HpostFor` — the exact shape `#derive_row`
emits.  (`HpostFor` is definitionally the `hpost` argument, so this is `segToTriple`
with the premise named.) -/
theorem segRow_of_hpost (bs : List BBlock) (L : GRegs) (lds : List (List (BitVec 8)))
    (pc0 : BitVec 64) (m0 : Std.ExtHashMap Nat (BitVec 8)) (Q : Config → Prop)
    (hwf : ChainOK pc0 (keysG L) bs)
    (hpost : HpostFor bs L lds pc0 m0 Q) :
    Triple (SegPre bs L lds pc0 m0) Q :=
  segToTriple bs L lds pc0 m0 Q hwf hpost

#print axioms segRow_of_hpost

/-! ## `#derive_row` -/

syntax (name := deriveRowCmd)
  "#derive_row " ident
    " seg " term:max
    " pins " term:max
    " lds " term:max
    " entry " term:max
    " mem " term:max
    " post " term:max : command

@[command_elab deriveRowCmd]
def elabDeriveRow : CommandElab := fun stx => do
  -- Index the syntax positionally (the keyword-separated `term:max` slots make a
  -- `\`(command| …)` MATCH pattern mis-parse the antiquotations; positional access
  -- is robust).  Layout: [0]="#derive_row " [1]=ident [2]=" seg " [3]=seg
  -- [4]=" pins " [5]=pins [6]=" lds " [7]=lds [8]=" entry " [9]=pc0 [10]=" mem "
  -- [11]=m0 [12]=" post " [13]=Q.
  -- NB: the local names avoid the command's own keyword tokens (`seg`/`pins`/…),
  -- which `syntax " seg " …` reserved and so can no longer be identifiers.
  let nm   : Ident := ⟨stx[1]⟩
  let bs   : TSyntax `term := ⟨stx[3]⟩
  let pinL : TSyntax `term := ⟨stx[5]⟩
  let ldsL : TSyntax `term := ⟨stx[7]⟩
  let pc0  : TSyntax `term := ⟨stx[9]⟩
  let mem0 : TSyntax `term := ⟨stx[11]⟩
  let postQ : TSyntax `term := ⟨stx[13]⟩
  elabCommand <|← `(command|
    /-- Generated by `#derive_row`: the seg→`Triple` marshalling skeleton with
    the row's one semantic obligation named (`hpost : HpostFor …`) and its
    structural VC discharged by one kernel `decide`. -/
    theorem $nm (hpost : Vsa.Sim.HpostFor $bs $pinL $ldsL $pc0 $mem0 $postQ) :
        Vsa.Logic.Triple (Vsa.Sim.SegPre $bs $pinL $ldsL $pc0 $mem0) $postQ :=
      Vsa.Sim.segRow_of_hpost $bs $pinL $ldsL $pc0 $mem0 $postQ (by decide) hpost)

/-! ## Demo — `#derive_row` on `demoChain` (the `DeriveCaseRow` demo seg)

Reproduces `demoChainRow` (`DeriveCaseRow.lean`) but with the `hpost` projection
EXPOSED as the named premise the command leaves.  `DemoRowPost` is the same
concrete post (`x7 = 3`, memory unchanged) read off the outcome. -/

def DemoRowPost (m0 : Std.ExtHashMap Nat (BitVec 8)) (c : Config) : Prop :=
  GoodState c.σ ∧
  c.σ.mem = m0 ∧
  c.σ.regs.get? Register.PC = some 0x8000000c#64 ∧
  gprGet c.σ 7 = some 3#64

variable (m0Ghost : Std.ExtHashMap Nat (BitVec 8))

#derive_row demoRowGen
  seg demoChain pins [] lds [] entry 0x80000000#64 mem m0Ghost post (DemoRowPost m0Ghost)

#print axioms demoRowGen

end Vsa.Sim
