/-- **survive** a disjoint 8-byte store (`sd`). -/
theorem pinw8_survives_writeMap8 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 8)} (k : Nat) (d : BitVec (8 * 8))
    (hdis : k + 8 ≤ a ∨ a + 8 ≤ k) (h : PinW8 mem a v) :
