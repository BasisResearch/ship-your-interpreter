    PinW8 (writeMap8 mem a v) a v :=
  ⟨getElem_writeMap8_0 _ _ _,
   getElem_writeMap8_1 _ _ _,
   getElem_writeMap8_2 _ _ _,
   getElem_writeMap8_3 _ _ _,
   getElem_writeMap8_4 _ _ _,
   getElem_writeMap8_5 _ _ _,
   getElem_writeMap8_6 _ _ _,
   getElem_writeMap8_7 _ _ _⟩

