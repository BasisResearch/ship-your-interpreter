import Vsa.Sim.ValueSites
import Vsa.Sim.ValueSpec
import Vsa.Sim.ValueTruthySpec
import Vsa.Sim.SnprintfSpec5
import Vsa.Sim.SnprintfSpec19

/-!
# `PinW` — width-indexed byte-window memory pins (widths 1/2/4/8)

GENERATED by `scripts/gen_pinw.py` — edit the generator, not this file.

`PinW<w> mem a v` pins the `w` little-endian bytes of `v : BitVec (8*<w>)` at
`[a, a+<w>)`.  This is the single shape behind the per-width near-copies
`SlotHolds` (`SnprintfSpec5`), `Pin8`/`Pin4` (`SnprintfSpec19`), and the widths
2/1 about to be needed.  Per width the API is uniform:

* `pinw<w>_of_writeMap`      — a `writeMap<w>` store image establishes the pin;
* `pinw<w>_survives_insert` / `pinw<w>_survives_writeMap{1,2,4,8}`
                             — transport across disjoint stores;
* `pinw<w>_survives_frame`   — transport across a pointwise "outside `[lo,hi)`
                             unchanged" frame (verified sub-call postconditions);
* `pinw<w>_bytes`            — unpack to the `h0…h(w-1)` byte facts load sites want;
* `pinw<w>_reassemble`       — the LE append chain of the extracts is `v`
                             (plus the `sext` `lw`/`ld` shapes at widths 4/8).

Conversion is free: `pin8_iff_Pin8`, `pin4_iff_Pin4`, `pinW8_iff_slotHolds` are
all `Iff.rfl` — the existing definitions are literally `PinW` instances (`Pin8`
at the `sdData_val` byte image, `SlotHolds` at the `base + sext (ofNat12 off)`
address shape).

`writeMap2`/`writeMap1` (the `sh`/`sb` store images) are introduced here,
mirroring `writeMap4`/`writeMap8` (`ValueSites`).
-/

open LeanRV64DExecutable LeanRV64DExecutable.Functions Sail ConcurrencyInterfaceV1 Vsa

set_option maxHeartbeats 4000000
set_option maxRecDepth 1000000

namespace Vsa.Sim

/-! ## Width-2 / width-1 write-maps (missing analogues of `writeMap4`/`writeMap8`) -/

/-- The width-2 write-map: `mem` updated with 2 little-endian bytes at `a`. -/
abbrev writeMap2 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (d : BitVec (8 * 2)) :
    Std.ExtHashMap Nat (BitVec 8) :=
  (mem.insert a (d.extractLsb' 0 8)).insert (a + 1) (d.extractLsb' 8 8)

/-- The width-1 write-map: `mem` updated with 1 byte at `a` (the `sb` image). -/
abbrev writeMap1 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (d : BitVec (8 * 1)) :
    Std.ExtHashMap Nat (BitVec 8) :=
  mem.insert a (d.extractLsb' 0 8)

/-! ## Small recon helpers -/

/-- LE reconstruction at width 2: `(b1 ++ b0).toNat = b0 + 256*b1`
(the width-2 analogue of `word_toNat_recon` / `word8_toNat_recon`). -/
theorem word2_toNat_recon (b0 b1 : BitVec 8) :
    ((b1.append b0) : BitVec (8 * 2)).toNat = b0.toNat + 256 * b1.toNat := by
  simp only [BitVec.append_eq, BitVec.toNat_append]
  have h0 := b0.isLt
  have h1 := b1.isLt
  rw [← Nat.shiftLeft_add_eq_or_of_lt (by omega)]
  simp only [Nat.shiftLeft_eq, Nat.reducePow]
  omega

/-- The width-8 store-data slice is the identity: `sdData_val v = v`. -/
theorem sdData_val_id (v : BitVec 64) : sdData_val v = v :=
  BitVec.eq_of_toNat_eq (sdData_toNat v)

/-! ## Width 1 -/

/-- The 1 little-endian byte of `v` pinned at `[a, a+1)`. -/
def PinW1 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 1)) : Prop :=
  mem[a]? = some (v.extractLsb' 0 8)

/-- **store ⇒ pin**: a `writeMap1` store image establishes the pin. -/
theorem pinw1_of_writeMap (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 1)) :
    PinW1 (writeMap1 mem a v) a v :=
  getElem_insert_self _ _ _

/-- **survive** a disjoint single byte insert. -/
theorem pinw1_survives_insert {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (k : Nat) (b : BitVec 8)
    (hdis : k < a ∨ a + 1 ≤ k) (h : PinW1 mem a v) : PinW1 (mem.insert k b) a v := by
  show (mem.insert k b)[a]? = some (v.extractLsb' 0 8)
  rw [Std.ExtHashMap.getElem?_insert, if_neg (by simp only [beq_iff_eq]; omega)]
  exact h

/-- **survive** a disjoint 1-byte store (`sb`). -/
theorem pinw1_survives_writeMap1 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (k : Nat) (d : BitVec (8 * 1))
    (hdis : k + 1 ≤ a ∨ a + 1 ≤ k) (h : PinW1 mem a v) :
    PinW1 (writeMap1 mem k d) a v :=
  pinw1_survives_insert k _ (by omega) h

/-- **survive** a disjoint 2-byte store (`sh`). -/
theorem pinw1_survives_writeMap2 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (k : Nat) (d : BitVec (8 * 2))
    (hdis : k + 2 ≤ a ∨ a + 1 ≤ k) (h : PinW1 mem a v) :
    PinW1 (writeMap2 mem k d) a v :=
  pinw1_survives_insert (k + 1) _ (by omega)
    (pinw1_survives_insert k _ (by omega) h)

/-- **survive** a disjoint 4-byte store (`sw`). -/
theorem pinw1_survives_writeMap4 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (k : Nat) (d : BitVec (8 * 4))
    (hdis : k + 4 ≤ a ∨ a + 1 ≤ k) (h : PinW1 mem a v) :
    PinW1 (writeMap4 mem k d) a v := by
  show (writeMap4 mem k d)[a]? = some (v.extractLsb' 0 8)
  rw [getElem_writeMap4_disjoint _ _ _ _ (by omega)]
  exact h

/-- **survive** a disjoint 8-byte store (`sd`). -/
theorem pinw1_survives_writeMap8 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (k : Nat) (d : BitVec (8 * 8))
    (hdis : k + 8 ≤ a ∨ a + 1 ≤ k) (h : PinW1 mem a v) :
    PinW1 (writeMap8 mem k d) a v := by
  show (writeMap8 mem k d)[a]? = some (v.extractLsb' 0 8)
  rw [getElem_writeMap8_disjoint _ _ _ _ (by omega)]
  exact h

/-- **survive** a whole verified sub-call: any memory transition with a
pointwise frame "outside `[lo, hi)` unchanged" preserves a pin whose window
lies entirely below `lo` or entirely at/above `hi`
(mirrors `slot_survives_frame`, `SlotFrame`). -/
theorem pinw1_survives_frame {mem mem' : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 1)} (lo hi : Nat)
    (hframe : ∀ j, (j < lo ∨ hi ≤ j) → mem'[j]? = mem[j]?)
    (hwin : a + 1 ≤ lo ∨ hi ≤ a) (h : PinW1 mem a v) : PinW1 mem' a v := by
  show mem'[a]? = some (v.extractLsb' 0 8)
  rw [hframe _ (by omega)]
  exact h

/-- **unpack**: the individual byte facts, in exactly the `mem[a + k]? = some bk`
shape a load site's `h0…h0` hypotheses want. -/
theorem pinw1_bytes (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 1))
    (h : PinW1 mem a v) :
    mem[a]? = some (v.extractLsb' 0 8) := h

/-- **reassemble**: the single byte extract is `v`. -/
theorem pinw1_reassemble (v : BitVec (8 * 1)) : v.extractLsb' 0 8 = v := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.extractLsb', BitVec.toNat_ofNat, Nat.shiftRight_eq_div_pow]
  have hv : v.toNat < 2 ^ 8 := v.isLt
  omega
/-! ## Width 2 -/

/-- The 2 little-endian bytes of `v` pinned at `[a, a+2)`. -/
def PinW2 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 2)) : Prop :=
  mem[a]? = some (v.extractLsb' 0 8) ∧
  mem[a + 1]? = some (v.extractLsb' 8 8)

/-- **store ⇒ pin**: a `writeMap2` store image establishes the pin. -/
theorem pinw2_of_writeMap (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 2)) :
    PinW2 (writeMap2 mem a v) a v := by
  refine ⟨?_, ?_⟩
  · simp only [writeMap2]
    rw [getElem_insert_ne _ _ _ _ (by simp only [beq_eq_false_iff_ne, ne_eq]; omega),
      getElem_insert_self]
  · simp only [writeMap2]
    rw [getElem_insert_self]

/-- **survive** a disjoint single byte insert. -/
theorem pinw2_survives_insert {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (k : Nat) (b : BitVec 8)
    (hdis : k < a ∨ a + 2 ≤ k) (h : PinW2 mem a v) : PinW2 (mem.insert k b) a v := by
  obtain ⟨h0, h1⟩ := h
  refine ⟨?_, ?_⟩ <;>
    rw [Std.ExtHashMap.getElem?_insert, if_neg (by simp only [beq_iff_eq]; omega)] <;> assumption

/-- **survive** a disjoint 1-byte store (`sb`). -/
theorem pinw2_survives_writeMap1 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (k : Nat) (d : BitVec (8 * 1))
    (hdis : k + 1 ≤ a ∨ a + 2 ≤ k) (h : PinW2 mem a v) :
    PinW2 (writeMap1 mem k d) a v :=
  pinw2_survives_insert k _ (by omega) h

/-- **survive** a disjoint 2-byte store (`sh`). -/
theorem pinw2_survives_writeMap2 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (k : Nat) (d : BitVec (8 * 2))
    (hdis : k + 2 ≤ a ∨ a + 2 ≤ k) (h : PinW2 mem a v) :
    PinW2 (writeMap2 mem k d) a v :=
  pinw2_survives_insert (k + 1) _ (by omega)
    (pinw2_survives_insert k _ (by omega) h)

/-- **survive** a disjoint 4-byte store (`sw`). -/
theorem pinw2_survives_writeMap4 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (k : Nat) (d : BitVec (8 * 4))
    (hdis : k + 4 ≤ a ∨ a + 2 ≤ k) (h : PinW2 mem a v) :
    PinW2 (writeMap4 mem k d) a v := by
  obtain ⟨h0, h1⟩ := h
  refine ⟨?_, ?_⟩ <;>
    rw [getElem_writeMap4_disjoint _ _ _ _ (by omega)] <;> assumption

/-- **survive** a disjoint 8-byte store (`sd`). -/
theorem pinw2_survives_writeMap8 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (k : Nat) (d : BitVec (8 * 8))
    (hdis : k + 8 ≤ a ∨ a + 2 ≤ k) (h : PinW2 mem a v) :
    PinW2 (writeMap8 mem k d) a v := by
  obtain ⟨h0, h1⟩ := h
  refine ⟨?_, ?_⟩ <;>
    rw [getElem_writeMap8_disjoint _ _ _ _ (by omega)] <;> assumption

/-- **survive** a whole verified sub-call: any memory transition with a
pointwise frame "outside `[lo, hi)` unchanged" preserves a pin whose window
lies entirely below `lo` or entirely at/above `hi`
(mirrors `slot_survives_frame`, `SlotFrame`). -/
theorem pinw2_survives_frame {mem mem' : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 2)} (lo hi : Nat)
    (hframe : ∀ j, (j < lo ∨ hi ≤ j) → mem'[j]? = mem[j]?)
    (hwin : a + 2 ≤ lo ∨ hi ≤ a) (h : PinW2 mem a v) : PinW2 mem' a v := by
  obtain ⟨h0, h1⟩ := h
  refine ⟨?_, ?_⟩ <;>
    rw [hframe _ (by omega)] <;> assumption

/-- **unpack**: the individual byte facts, in exactly the `mem[a + k]? = some bk`
shape a load site's `h0…h1` hypotheses want. -/
theorem pinw2_bytes (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 2))
    (h : PinW2 mem a v) :
    mem[a]? = some (v.extractLsb' 0 8) ∧
    mem[a + 1]? = some (v.extractLsb' 8 8) := h

/-- **reassemble**: the LE append chain of the byte extracts is `v`. -/
theorem pinw2_reassemble (v : BitVec (8 * 2)) :
    (((v.extractLsb' 8 8).append (v.extractLsb' 0 8)) : BitVec (8 * 2)) = v := by
  apply BitVec.eq_of_toNat_eq
  rw [word2_toNat_recon]
  simp only [BitVec.extractLsb', BitVec.toNat_ofNat, Nat.shiftRight_eq_div_pow]
  have hv : v.toNat < 2 ^ 16 := v.isLt
  omega
/-! ## Width 4 -/

/-- The 4 little-endian bytes of `v` pinned at `[a, a+4)`. -/
def PinW4 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 4)) : Prop :=
  mem[a]? = some (v.extractLsb' 0 8) ∧
  mem[a + 1]? = some (v.extractLsb' 8 8) ∧
  mem[a + 2]? = some (v.extractLsb' 16 8) ∧
  mem[a + 3]? = some (v.extractLsb' 24 8)

/-- **store ⇒ pin**: a `writeMap4` store image establishes the pin. -/
theorem pinw4_of_writeMap (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 4)) :
    PinW4 (writeMap4 mem a v) a v :=
  ⟨getElem_writeMap4_0 _ _ _,
   getElem_writeMap4_1 _ _ _,
   getElem_writeMap4_2 _ _ _,
   getElem_writeMap4_3 _ _ _⟩

/-- **survive** a disjoint single byte insert. -/
theorem pinw4_survives_insert {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (k : Nat) (b : BitVec 8)
    (hdis : k < a ∨ a + 4 ≤ k) (h : PinW4 mem a v) : PinW4 (mem.insert k b) a v := by
  obtain ⟨h0, h1, h2, h3⟩ := h
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [Std.ExtHashMap.getElem?_insert, if_neg (by simp only [beq_iff_eq]; omega)] <;> assumption

/-- **survive** a disjoint 1-byte store (`sb`). -/
theorem pinw4_survives_writeMap1 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (k : Nat) (d : BitVec (8 * 1))
    (hdis : k + 1 ≤ a ∨ a + 4 ≤ k) (h : PinW4 mem a v) :
    PinW4 (writeMap1 mem k d) a v :=
  pinw4_survives_insert k _ (by omega) h

/-- **survive** a disjoint 2-byte store (`sh`). -/
theorem pinw4_survives_writeMap2 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (k : Nat) (d : BitVec (8 * 2))
    (hdis : k + 2 ≤ a ∨ a + 4 ≤ k) (h : PinW4 mem a v) :
    PinW4 (writeMap2 mem k d) a v :=
  pinw4_survives_insert (k + 1) _ (by omega)
    (pinw4_survives_insert k _ (by omega) h)

/-- **survive** a disjoint 4-byte store (`sw`). -/
theorem pinw4_survives_writeMap4 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (k : Nat) (d : BitVec (8 * 4))
    (hdis : k + 4 ≤ a ∨ a + 4 ≤ k) (h : PinW4 mem a v) :
    PinW4 (writeMap4 mem k d) a v := by
  obtain ⟨h0, h1, h2, h3⟩ := h
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [getElem_writeMap4_disjoint _ _ _ _ (by omega)] <;> assumption

/-- **survive** a disjoint 8-byte store (`sd`). -/
theorem pinw4_survives_writeMap8 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (k : Nat) (d : BitVec (8 * 8))
    (hdis : k + 8 ≤ a ∨ a + 4 ≤ k) (h : PinW4 mem a v) :
    PinW4 (writeMap8 mem k d) a v := by
  obtain ⟨h0, h1, h2, h3⟩ := h
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [getElem_writeMap8_disjoint _ _ _ _ (by omega)] <;> assumption

/-- **survive** a whole verified sub-call: any memory transition with a
pointwise frame "outside `[lo, hi)` unchanged" preserves a pin whose window
lies entirely below `lo` or entirely at/above `hi`
(mirrors `slot_survives_frame`, `SlotFrame`). -/
theorem pinw4_survives_frame {mem mem' : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 4)} (lo hi : Nat)
    (hframe : ∀ j, (j < lo ∨ hi ≤ j) → mem'[j]? = mem[j]?)
    (hwin : a + 4 ≤ lo ∨ hi ≤ a) (h : PinW4 mem a v) : PinW4 mem' a v := by
  obtain ⟨h0, h1, h2, h3⟩ := h
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    rw [hframe _ (by omega)] <;> assumption

/-- **unpack**: the individual byte facts, in exactly the `mem[a + k]? = some bk`
shape a load site's `h0…h3` hypotheses want. -/
theorem pinw4_bytes (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 4))
    (h : PinW4 mem a v) :
    mem[a]? = some (v.extractLsb' 0 8) ∧
    mem[a + 1]? = some (v.extractLsb' 8 8) ∧
    mem[a + 2]? = some (v.extractLsb' 16 8) ∧
    mem[a + 3]? = some (v.extractLsb' 24 8) := h

/-- **reassemble**: the LE append chain of the byte extracts is `v`
(wraps `word4_eq_sp`, `SnprintfSpec19` — `word_toNat_recon`-based). -/
theorem pinw4_reassemble (v : BitVec (8 * 4)) :
    (((((v.extractLsb' 24 8).append (v.extractLsb' 16 8)).append (v.extractLsb' 8 8)).append (v.extractLsb' 0 8)) : BitVec (8 * 4)) = v :=
  word4_eq_sp v

/-- **reassemble (`lw` shape)**: the sign-extended 4-byte reassembly is `sext v`
(wraps `lw_cap_reassemble_sp`, `SnprintfSpec19`). -/
theorem pinw4_sext_reassemble (v : BitVec (8 * 4)) :
    (sign_extend (m := 64)
      (((((v.extractLsb' 24 8).append (v.extractLsb' 16 8)).append (v.extractLsb' 8 8)).append (v.extractLsb' 0 8)) : BitVec (8 * 4)) : BitVec 64) = sign_extend (m := 64) v :=
  lw_cap_reassemble_sp v
/-! ## Width 8 -/

/-- The 8 little-endian bytes of `v` pinned at `[a, a+8)`. -/
def PinW8 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 8)) : Prop :=
  mem[a]? = some (v.extractLsb' 0 8) ∧
  mem[a + 1]? = some (v.extractLsb' 8 8) ∧
  mem[a + 2]? = some (v.extractLsb' 16 8) ∧
  mem[a + 3]? = some (v.extractLsb' 24 8) ∧
  mem[a + 4]? = some (v.extractLsb' 32 8) ∧
  mem[a + 5]? = some (v.extractLsb' 40 8) ∧
  mem[a + 6]? = some (v.extractLsb' 48 8) ∧
  mem[a + 7]? = some (v.extractLsb' 56 8)

