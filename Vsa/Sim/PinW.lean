/-- **survive** a whole verified sub-call: any memory transition with a
pointwise frame "outside `[lo, hi)` unchanged" preserves a pin whose window
lies entirely below `lo` or entirely at/above `hi`
(mirrors `slot_survives_frame`, `SlotFrame`). -/
theorem pinw8_survives_frame {mem mem' : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 8)} (lo hi : Nat)
    (hframe : ∀ j, (j < lo ∨ hi ≤ j) → mem'[j]? = mem[j]?)
    (hwin : a + 8 ≤ lo ∨ hi ≤ a) (h : PinW8 mem a v) : PinW8 mem' a v := by
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    rw [hframe _ (by omega)] <;> assumption

/-- **unpack**: the individual byte facts, in exactly the `mem[a + k]? = some bk`
shape a load site's `h0…h7` hypotheses want. -/
theorem pinw8_bytes (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec (8 * 8))
    (h : PinW8 mem a v) :
    mem[a]? = some (v.extractLsb' 0 8) ∧
    mem[a + 1]? = some (v.extractLsb' 8 8) ∧
    mem[a + 2]? = some (v.extractLsb' 16 8) ∧
    mem[a + 3]? = some (v.extractLsb' 24 8) ∧
    mem[a + 4]? = some (v.extractLsb' 32 8) ∧
    mem[a + 5]? = some (v.extractLsb' 40 8) ∧
    mem[a + 6]? = some (v.extractLsb' 48 8) ∧
    mem[a + 7]? = some (v.extractLsb' 56 8) := h

/-- **reassemble**: the LE append chain of the byte extracts is `v`
(`word8_toNat_recon`-based). -/
theorem pinw8_reassemble (v : BitVec (8 * 8)) :
    (((((((((v.extractLsb' 56 8).append (v.extractLsb' 48 8)).append (v.extractLsb' 40 8)).append (v.extractLsb' 32 8)).append (v.extractLsb' 24 8)).append (v.extractLsb' 16 8)).append (v.extractLsb' 8 8)).append (v.extractLsb' 0 8)) : BitVec (8 * 8)) = v := by
  apply BitVec.eq_of_toNat_eq
  rw [word8_toNat_recon]
  simp only [BitVec.extractLsb', BitVec.toNat_ofNat, Nat.shiftRight_eq_div_pow]
  have hv : v.toNat < 2 ^ 64 := v.isLt
  omega

/-- **reassemble (`ld` shape)**: the sign-extended 8-byte reassembly is `v`
(`ve_sext_reassemble` generalized from `sdData_val` images to any `v`). -/
theorem pinw8_sext_reassemble (v : BitVec (8 * 8)) :
    (sign_extend (m := 64)
      (((((((((v.extractLsb' 56 8).append (v.extractLsb' 48 8)).append (v.extractLsb' 40 8)).append (v.extractLsb' 32 8)).append (v.extractLsb' 24 8)).append (v.extractLsb' 16 8)).append (v.extractLsb' 8 8)).append (v.extractLsb' 0 8)) : BitVec (8 * 8)) : BitVec 64) = v := by
  rw [sext_full]
  exact pinw8_reassemble v
/-! ## Bridges to the existing per-width pins (all definitional) -/

/-- `Pin8` (`SnprintfSpec19`) *is* `PinW8` at the `sdData_val` byte image. -/
theorem pin8_iff_Pin8 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (v : BitVec 64) :
    PinW8 mem a (sdData_val v) ↔ Pin8 mem a v := Iff.rfl

/-- `Pin4` (`SnprintfSpec19`) *is* `PinW4` (`BitVec 32 = BitVec (8*4)` definitionally). -/
theorem pin4_iff_Pin4 (mem : Std.ExtHashMap Nat (BitVec 8)) (a : Nat) (w : BitVec 32) :
    PinW4 mem a w ↔ Pin4 mem a w := Iff.rfl

/-- `SlotHolds` (`SnprintfSpec5`) *is* `PinW8` at the `base + sext (ofNat12 off)`
effective address and the `sdData_val` byte image. -/
theorem pinW8_iff_slotHolds (base : BitVec 64) (off : Nat) (v : BitVec 64)
    (mem : Std.ExtHashMap Nat (BitVec 8)) :
    PinW8 mem ((base + sign_extend (m := 64) (BitVec.ofNat 12 off)).toNat) (sdData_val v)
      ↔ SlotHolds base off v mem := Iff.rfl

end Vsa.Sim
