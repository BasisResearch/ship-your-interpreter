/-- **survive** a disjoint 4-byte store (`sw`). -/
theorem pinw8_survives_writeMap4 {mem : Std.ExtHashMap Nat (BitVec 8)} {a : Nat}
    {v : BitVec (8 * 8)} (k : Nat) (d : BitVec (8 * 4))
