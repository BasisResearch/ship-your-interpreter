/-- EvalE-rooted mutual recursion from the named bundle. -/
theorem term_sim_of_bundle (B : TermCases)
    {st : SpecSt} {d : Nat} {env : Addr} {e : Expr} {st' : SpecSt} {v : Value}
    (t : EvalE st d env e st' v) : mEvalE st d env e st' v t :=
  Vsa.Sim.TermSimAssembly.term_sim_of_cases
      B.hInt B.hStr B.hBool B.hNull B.hVar B.hAssign B.hBinary B.hOrTrue
      B.hOrFalse B.hAndFalse B.hAndTrue B.hNeg B.hNot B.hCall B.hFn B.hArgsNil
      B.hArgsCons B.hCallClosure B.hCallPrint B.hCallPrintln B.hCallAssertOk B.hSExpr B.hSVarInit B.hSVarNull
      B.hSBlock B.hSIfTrue B.hSIfFalse B.hSIfNone B.hSWhileFalse B.hSWhileBreak B.hSWhileRet B.hSWhileLoop
      B.hSForStart B.hSRet B.hSRetNull B.hSBrk B.hSCont B.hInitNone B.hInitSome B.hFlCondFalse
      B.hFlBodyBreak B.hFlBodyRet B.hFlLoop B.hFcNone B.hFcSome B.hEsNone B.hEsSome B.hSeqNil
      B.hSeqConsNormal B.hSeqConsAbrupt
      t

/-- ExecSeq-rooted mutual recursion from the same named bundle. -/
theorem execSeq_sim_of_bundle (B : TermCases)
    {st : SpecSt} {d : Nat} {env : Addr} {ss : List Stmt} {st' : SpecSt}
    {status : Status}
    (t : ExecSeq st d env ss st' status) : mExecSeq st d env ss st' status t :=
  Vsa.Sim.TermSimClose.execSeq_sim_of_cases
      B.hInt B.hStr B.hBool B.hNull B.hVar B.hAssign B.hBinary B.hOrTrue
      B.hOrFalse B.hAndFalse B.hAndTrue B.hNeg B.hNot B.hCall B.hFn B.hArgsNil
      B.hArgsCons B.hCallClosure B.hCallPrint B.hCallPrintln B.hCallAssertOk B.hSExpr B.hSVarInit B.hSVarNull
      B.hSBlock B.hSIfTrue B.hSIfFalse B.hSIfNone B.hSWhileFalse B.hSWhileBreak B.hSWhileRet B.hSWhileLoop
      B.hSForStart B.hSRet B.hSRetNull B.hSBrk B.hSCont B.hInitNone B.hInitSome B.hFlCondFalse
      B.hFlBodyBreak B.hFlBodyRet B.hFlLoop B.hFcNone B.hFcSome B.hEsNone B.hEsSome B.hSeqNil
      B.hSeqConsNormal B.hSeqConsAbrupt
      t

/-- `InterpSim.term_sim` from the case bundle and the sole entry bridge. -/
theorem termSimClosed_of_bundle (L : Layout) (B : TermCases)
    (hEntryHalts :
      ∀ (p : Program) (c : Config) (out : String) (st' : SpecSt)
              (t : ExecSeq initSt 0 0 p st' Status.normal),
              Loaded L p c → st'.out = out →
              mExecSeq initSt 0 0 p st' Status.normal t →
              Halts c out 0) :
    ∀ (p : Program) (c : Config) (out : String),
      Loaded L p c → BigStep p out → Halts c out 0 :=
  Vsa.Sim.TermSimClose.termSimClosed L
      B.hInt B.hStr B.hBool B.hNull B.hVar B.hAssign B.hBinary B.hOrTrue
      B.hOrFalse B.hAndFalse B.hAndTrue B.hNeg B.hNot B.hCall B.hFn B.hArgsNil
      B.hArgsCons B.hCallClosure B.hCallPrint B.hCallPrintln B.hCallAssertOk B.hSExpr B.hSVarInit B.hSVarNull
      B.hSBlock B.hSIfTrue B.hSIfFalse B.hSIfNone B.hSWhileFalse B.hSWhileBreak B.hSWhileRet B.hSWhileLoop
      B.hSForStart B.hSRet B.hSRetNull B.hSBrk B.hSCont B.hInitNone B.hInitSome B.hFlCondFalse
      B.hFlBodyBreak B.hFlBodyRet B.hFlLoop B.hFcNone B.hFcSome B.hEsNone B.hEsSome B.hSeqNil
      B.hSeqConsNormal B.hSeqConsAbrupt
      hEntryHalts

