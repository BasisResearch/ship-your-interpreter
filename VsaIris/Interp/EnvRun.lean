import VsaIris.Vsa.SymRun
import VsaIris.Interp.EnvCode

/-!
# `env.c`'s symbolic runs

`EW live S Q pc R Mt` is `SWP` for the `env_*` helpers: the code is `envText`
(every instruction of `env_new`, `env_define`, `env_get`, `env_set`, from
`EnvCode.lean`), and the owned registers are `eRegs`. The step table
`EnvSteps/*.lean` (generated by `scripts/gen_alloc_steps.py --target env`)
gives one lemma `st_<pc>` per instruction, stated over `EW`, so H4's driver
`sx_run` (`AllocTac.lean`) runs `env.c` too. Calls leave the symbolic run: a
span ends at its `jal`, and the call is taken at the Iris level against the
callee's spec.
-/

namespace VsaIris.Sym

open Vsa.MemRepr

/-- The registers an `env_*` span owns: `PC`, `ra`, `a0`, `sp`, the
caller-saved temporaries and arguments, and `s0-s6` (the callee-saved
registers `env_define` spills; the others use a prefix of them). -/
abbrev eRegs : List Nat :=
  [32, 1, 10, 2, 5, 6, 7, 11, 12, 13, 14, 15, 16, 17, 28, 29, 30, 31, 8, 9, 18, 19, 20, 21, 22]

/-- An `env_*` span at a symbolic state. -/
abbrev EW (live : Nat → Prop) (S : Nat → Prop) (Q : (Nat → BitVec 64) → (Nat → BitVec 8) → Prop) :
    BitVec 64 → (Nat → BitVec 64) → Mem → Prop :=
  SWP live envText eRegs S Q

end VsaIris.Sym
