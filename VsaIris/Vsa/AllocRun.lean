import VsaIris.Vsa.SymRun
import VsaIris.Vsa.AllocCode

/-!
# The allocator's symbolic runs

`AW live S Q pc R Mt` is `SWP` for the allocator: the code is `allocText`
(every instruction of `malloc`, `free`, `realloc` and their callees, from
`AllocCode.lean`), and the owned registers are `aRegs`, the registers
`DlMallocImpl` hands the allocator. The step table `AllocSteps/*.lean`
(generated by `scripts/gen_alloc_steps.py`) gives one lemma `st_<pc>` per
instruction, stated over `AW`.
-/

namespace VsaIris.Sym

open Vsa.MemRepr

/-- The registers an allocator call owns: `PC`, `ra`, `a0`, `sp`, the
caller-saved temporaries and arguments, and `s0-s3` (`allocRegs vsaClob
vsaSaved`, `aRegs_eq`). -/
abbrev aRegs : List Nat := [32, 1, 10, 2, 5, 6, 7, 11, 12, 13, 14, 15, 16, 17, 28, 29, 30, 31, 8, 9, 18, 19]

/-- The allocator's run at a symbolic state. -/
abbrev AW (live : Nat → Prop) (S : Nat → Prop) (Q : (Nat → BitVec 64) → (Nat → BitVec 8) → Prop) :
    BitVec 64 → (Nat → BitVec 64) → Mem → Prop :=
  SWP live allocText aRegs S Q

end VsaIris.Sym
