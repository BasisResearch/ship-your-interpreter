import VsaIris.Vsa.MallocFastSegs
import VsaIris.Vsa.MallocFastHeap

/-!
# `_free_r`'s top-merge path, reflected

The path for freeing the chunk just below the top, when its predecessor is in
use and the merged top stays below `__malloc_trim_threshold`:

* `segFWrap` (`free`): `mv a1,a0; ld a0,_impure_ptr; j _free_r`;
* `segFPro`: the non-null test, the 32-byte frame (`s0`, `q`, `ra`), up to
  the lock call at `0x80007368`;
* `segFBody`: the chunk and top headers, the top test, the prev-in-use test,
  the two merge stores, and the trim test;
* `segFEpi`: the epilogue and the tail jump to `__malloc_unlock`.

Chains generated by `scripts/emit_derive_case.py scripts/malloc_fast_segs.json`.
-/

open LeanRV64DExecutable LeanRV64DExecutable.Functions Sail Vsa

namespace Vsa.Sim

#derive_case segFWrap chain
  [(0x8000479c#64, 0x00050593#32),
   (0x800047a0#64, 0x4601b503#32)]
  terminator ⟨0x800047a4#64, 0x3ad0206f#32, 0x6f#8, 0x20#8, 0xd0#8, 0x3a#8,
      .j, 0, 0, 0#13, 0x002bac#21, 0#12⟩

#derive_case segFPro chain
  []
  terminator ⟨0x80007350#64, 0x12058863#32, 0x63#8, 0x88#8, 0x05#8, 0x12#8,
      .br bop.BEQ false, 11, 0, 0x130#13, 0#21, 0#12⟩ ;;
  [(0x80007354#64, 0xfe010113#32),
   (0x80007358#64, 0x00813823#32),
   (0x8000735c#64, 0x00b13423#32),
   (0x80007360#64, 0x00050413#32),
   (0x80007364#64, 0x00113c23#32)]

#derive_case segFBody chain
  [(0x8000736c#64, 0x00813583#32),
   (0x80007370#64, 0x00014897#32),
   (0x80007374#64, 0x9a088893#32),
   (0x80007378#64, 0x0108b803#32),
   (0x8000737c#64, 0xff85b503#32),
   (0x80007380#64, 0xff058713#32),
   (0x80007384#64, 0xffe57793#32),
   (0x80007388#64, 0x00f70633#32),
   (0x8000738c#64, 0x00863683#32),
   (0x80007390#64, 0x00157313#32),
   (0x80007394#64, 0xffc6f693#32)]
  terminator ⟨0x80007398#64, 0x18c80e63#32, 0x63#8, 0x0e#8, 0xc8#8, 0x18#8,
      .br bop.BEQ true, 16, 12, 0x19c#13, 0#21, 0#12⟩ ;;
  [(0x80007534#64, 0x00d786b3#32)]
  terminator ⟨0x80007538#64, 0x02031063#32, 0x63#8, 0x10#8, 0x03#8, 0x02#8,
      .br bop.BNE true, 6, 0, 0x020#13, 0#21, 0#12⟩ ;;
  [(0x80007558#64, 0x0016e613#32),
   (0x8000755c#64, 0x4581b783#32),
   (0x80007560#64, 0x00c73423#32),
   (0x80007564#64, 0x00e8b823#32)]
  terminator ⟨0x80007568#64, 0xecf6e6e3#32, 0xe3#8, 0xe6#8, 0xf6#8, 0xec#8,
      .br bop.BLTU true, 13, 15, 0x1ecc#13, 0#21, 0#12⟩

#derive_case segFEpi chain
  [(0x80007434#64, 0x00040513#32),
   (0x80007438#64, 0x01013403#32),
   (0x8000743c#64, 0x01813083#32),
   (0x80007440#64, 0x02010113#32)]
  terminator ⟨0x80007444#64, 0xc2dfd06f#32, 0x6f#8, 0xd0#8, 0xdf#8, 0xc2#8,
      .j, 0, 0, 0#13, 0x1fdc2c#21, 0#12⟩

end Vsa.Sim

namespace VsaIris.MallocFast

open Vsa.Sim
open VsaIris.VsaHeap (ofNat_toNat_lt)

theorem fwrap_facts {m : Std.ExtHashMap Nat (BitVec 8)} (hcode : PathLoaded m) (q a1 : BitVec 64) :
    ChainFacts m m (wrapL q a1) [impW] segFWrap := by
  unfold segFWrap ChainFacts
  chain_facts hcode with "VsaIris.MallocFast.path_at_"
  refine ldFact rfl 0x8001b970 ((ea_of gpV 1120 rfl (by decide) (by decide)).trans (by decide))
    (by decide) (by decide) (by decide) ?_
  change LPins8 m 0x8001b970 impW
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7⟩ := path_impure hcode
  simp only [LPins8, impW, List.getD_cons_zero, List.getD_cons_succ, h0, h1, h2, h3, h4, h5, h6, h7,
    Option.getD_some]
  exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-- `free`'s stack pointer. -/
abbrev spF (s : BitVec 64) : BitVec 64 := s + sign_extend (m := 64) (0xfe0#12)

theorem spF_toNat {s : BitVec 64} (h : SpGeom s) : (spF s).toNat = s.toNat - 32 := by
  have := h.lo; unfold tohostAddr at this
  exact sub_imm s _ 32 (by decide) (by omega) (by decide)

/-- A store into `free`'s frame `[s - 32, s)`. -/
theorem fstackStore {m : Std.ExtHashMap Nat (BitVec 8)} {L : GRegs} {a : MInstr} {bs : List (BitVec 8)}
    {s : BitVec 64} (h : SpGeom s) (off : Nat) (hk : a.kind = .sd)
    (hsrc : srcVal a.rs1 L = spF s)
    (himm : (sign_extend (m := 64) a.imm : BitVec 64).toNat = off) (hoff : off + 8 ≤ 32)
    (hoff8 : off % 8 = 0) : MemFacts m L bs a := by
  have h32 := spF_toNat h
  have hlo := h.lo; have hhi := h.hi; have hal := h.align
  unfold tohostAddr at hlo
  refine sdFact hk _ (ea_of _ off hsrc himm (by rw [h32]; omega)) ?_ ?_ ?_ ?_ <;>
    rw [h32] <;> first | omega | (unfold tohostAddr; omega)

abbrev fproL (s s0 r q a0 : BitVec 64) : GRegs := [(2, s), (8, s0), (1, r), (11, q), (10, a0)]

theorem fpro_facts {m : Std.ExtHashMap Nat (BitVec 8)} (hcode : PathLoaded m)
    {s s0 r q a0 : BitVec 64} (hs : SpGeom s) (hq : q ≠ 0#64) :
    ChainFacts m m (fproL s s0 r q a0) [] segFPro := by
  unfold segFPro ChainFacts
  chain_facts hcode with "VsaIris.MallocFast.path_at_"
  all_goals seg_norm
  · simpa using hq
  · exact fstackStore hs 16 rfl rfl (by decide) (by decide) (by decide)
  · exact fstackStore hs 8 rfl rfl (by decide) (by decide) (by decide)
  · exact fstackStore hs 24 rfl rfl (by decide) (by decide) (by decide)


abbrev fbodyL (sp a0 a1 a2 a3 a4 a5 a6 a7 t1 s0 r : BitVec 64) : GRegs :=
  [(2, sp), (10, a0), (11, a1), (12, a2), (13, a3), (14, a4), (15, a5), (16, a6), (17, a7), (6, t1),
   (8, s0), (1, r), (3, gpV)]

/-- `__malloc_trim_threshold`. -/
abbrev trimAddr : Nat := 0x8001b968

/-- The loads of `segFBody`: the saved `q`, `av->top`, the chunk's and the
top's headers, and the trim threshold. -/
abbrev fbodyLds (f : Nat → BitVec 8) (sp : BitVec 64) (c top : Nat) : List (List (BitVec 8)) :=
  [wordOf f (sp.toNat + 8), wordOf f Vsa.Sim.DlHeap.topAddr, wordOf f (c + 8), wordOf f (top + 8),
   wordOf f trimAddr]

/-- A load from a `w`-byte stack frame. -/
theorem frameLoadW {m : Std.ExtHashMap Nat (BitVec 8)} {L : GRegs} {a : MInstr} {f : Nat → BitVec 8}
    {sp : BitVec 64} {w : Nat} (hsp : tohostAddr + 16 ≤ sp.toNat) (hsp' : sp.toNat + w ≤ 0x100000000)
    (off : Nat) (hk : a.kind = .ld) (hsrc : srcVal a.rs1 L = sp)
    (himm : (sign_extend (m := 64) a.imm : BitVec 64).toNat = off) (hoff : off + 8 ≤ w)
    (hpin : ∀ k, k < w → (m[sp.toNat + k]?).getD 0 = f (sp.toNat + k)) :
    MemFacts m L (wordOf f (sp.toNat + off)) a := by
  unfold tohostAddr at hsp
  refine ldFact hk _ (ea_of sp off hsrc himm (by omega)) (by omega) (by omega)
    (by unfold tohostAddr; omega) (lpins_of_img fun k hk => ?_)
  rw [Nat.add_assoc]; exact hpin (off + k) (by omega)

/-- The merge's geometry: the chunk `[c, top)` below the top `[top, top + tsz)`. -/
structure FreeGeo (c top csz tsz thr : Nat) : Prop where
  c_lo : Vsa.Sim.DlHeap.heapStart ≤ c
  c16 : c % 16 = 0
  c_top : c + csz = top
  csz16 : csz % 16 = 0
  tsz16 : tsz % 16 = 0
  top_hi : top + tsz ≤ Vsa.Sim.DlHeap.heapEnd
  top_room : 16 ≤ tsz
  below : csz + tsz < thr
  thr_lt : thr < 2 ^ 64

/-- The words `segFBody` reads, over the image. -/
structure FBodyVals (f : Nat → BitVec 8) (sp : BitVec 64) (c top csz tsz thr : Nat) : Prop where
  q : bytesVal .ld (wordOf f (sp.toNat + 8)) = BitVec.ofNat 64 (c + 16)
  tptr : bytesVal .ld (wordOf f Vsa.Sim.DlHeap.topAddr) = BitVec.ofNat 64 top
  hdr : bytesVal .ld (wordOf f (c + 8)) = BitVec.ofNat 64 (csz + 1)
  thdr : bytesVal .ld (wordOf f (top + 8)) = BitVec.ofNat 64 (tsz + 1)
  thr : bytesVal .ld (wordOf f trimAddr) = BitVec.ofNat 64 thr

theorem and_one_toNat (a : BitVec 64) :
    (a &&& sign_extend (m := 64) (0x001#12)).toNat = a.toNat % 2 := by
  rw [show (sign_extend (m := 64) (0x001#12) : BitVec 64) = 1#64 by decide, BitVec.toNat_and]
  simp [Nat.and_one_is_mod]

/-- The values `segFBody` computes from the words it reads. -/
structure FBodyEqs (f : Nat → BitVec 8) (sp : BitVec 64) (c top csz tsz : Nat) : Prop where
  c8 : (bytesVal .ld (wordOf f (sp.toNat + 8)) + sign_extend (m := 64) (0xff8#12)).toNat = c + 8
  a4 : (bytesVal .ld (wordOf f (sp.toNat + 8)) + sign_extend (m := 64) (0xff0#12)).toNat = c
  a5 : (bytesVal .ld (wordOf f (c + 8)) &&& sign_extend (m := 64) (0xffe#12)).toNat = csz
  a2 : (bytesVal .ld (wordOf f (sp.toNat + 8)) + sign_extend (m := 64) (0xff0#12) +
      (bytesVal .ld (wordOf f (c + 8)) &&& sign_extend (m := 64) (0xffe#12))).toNat = top
  t : (bytesVal .ld (wordOf f (top + 8)) &&& sign_extend (m := 64) (0xffc#12)).toNat = tsz

theorem FBodyVals.eqs {f : Nat → BitVec 8} {sp : BitVec 64} {c top csz tsz thr : Nat}
    (V : FBodyVals f sp c top csz tsz thr) (G : FreeGeo c top csz tsz thr) :
    FBodyEqs f sp c top csz tsz := by
  have hclo := G.c_lo; have hct := G.c_top; have hcs := G.csz16
  have hts := G.tsz16; have hthi := G.top_hi
  unfold Vsa.Sim.DlHeap.heapStart at hclo; unfold Vsa.Sim.DlHeap.heapEnd at hthi
  have e_q : (bytesVal .ld (wordOf f (sp.toNat + 8))).toNat = c + 16 := by
    rw [V.q, ofNat_toNat_lt (by omega)]
  have e_a4 : (bytesVal .ld (wordOf f (sp.toNat + 8)) + sign_extend (m := 64) (0xff0#12)).toNat = c := by
    rw [sub_imm _ _ 16 (by decide) (by omega) (by decide), e_q]; omega
  have e_a5 : (bytesVal .ld (wordOf f (c + 8)) &&& sign_extend (m := 64) (0xffe#12)).toNat = csz := by
    rw [and_m2_toNat, V.hdr, ofNat_toNat_lt (by omega)]; omega
  refine ⟨?_, e_a4, e_a5, ?_, ?_⟩
  · rw [sub_imm _ _ 8 (by decide) (by omega) (by decide), e_q]; omega
  · rw [BitVec.toNat_add, e_a4, e_a5, Nat.mod_eq_of_lt (by omega)]; omega
  · rw [and_m4_toNat, V.thdr, ofNat_toNat_lt (by omega)]; omega

theorem fbody_facts {m : Std.ExtHashMap Nat (BitVec 8)} (hcode : PathLoaded m)
    {sp a0 a1 a2 a3 a4 a5 a6 a7 t1 s0 r : BitVec 64} {f : Nat → BitVec 8} {c top csz tsz thr : Nat}
    (hsp : tohostAddr + 16 ≤ sp.toNat) (hsp' : sp.toNat + 32 ≤ 0x100000000)
    (hpinF : ∀ k, k < 32 → (m[sp.toNat + k]?).getD 0 = f (sp.toNat + k))
    (hpinA : ∀ k, k < 8 → (m[Vsa.Sim.DlHeap.topAddr + k]?).getD 0 = f (Vsa.Sim.DlHeap.topAddr + k))
    (hpinR : ∀ k, k < 8 → (m[trimAddr + k]?).getD 0 = f (trimAddr + k))
    (hpinC : ∀ k, k < 8 → (m[c + 8 + k]?).getD 0 = f (c + 8 + k))
    (hpinT : ∀ k, k < 8 → (m[top + 8 + k]?).getD 0 = f (top + 8 + k))
    (G : FreeGeo c top csz tsz thr) (V : FBodyVals f sp c top csz tsz thr) :
    ChainFacts m m (fbodyL sp a0 a1 a2 a3 a4 a5 a6 a7 t1 s0 r) (fbodyLds f sp c top) segFBody := by
  have E := V.eqs G
  have hclo := G.c_lo; have hc16 := G.c16; have hct := G.c_top; have hcs := G.csz16
  have hts := G.tsz16; have hthi := G.top_hi; have hbel := G.below; have htr := G.top_room
  have hthr := G.thr_lt
  unfold Vsa.Sim.DlHeap.heapStart at hclo; unfold Vsa.Sim.DlHeap.heapEnd at hthi
  unfold segFBody ChainFacts
  chain_facts hcode with "VsaIris.MallocFast.path_at_"
  all_goals seg_norm
  all_goals (try simp only [fbodyLds, List.tail_cons])
  · exact frameLoadW hsp hsp' 8 rfl rfl (by decide) (by decide) hpinF
  · refine ldFact rfl Vsa.Sim.DlHeap.topAddr
      (by unfold eaddrM; seg_norm; decide) (by decide) (by decide)
      (by decide) (lpins_of_img hpinA)
  · refine ldFact rfl (c + 8) (by unfold eaddrM; seg_norm; exact E.c8) (by omega) (by omega)
      (by unfold tohostAddr; omega) (lpins_of_img hpinC)
  · refine ldFact rfl (top + 8) (by unfold eaddrM; seg_norm; rw [add_imm _ _ 8 (by decide) (by rw [E.a2]; omega), E.a2])
      (by omega) (by omega) (by unfold tohostAddr; omega) (lpins_of_img hpinT)
  · rw [beq_iff_eq]
    apply BitVec.eq_of_toNat_eq
    rw [E.a2, V.tptr, ofNat_toNat_lt (by omega)]
  · rw [bne_iff_ne, ne_eq, ← BitVec.toNat_inj, and_one_toNat, V.hdr, ofNat_toNat_lt (by omega)]
    simp; omega
  · refine ldFact rfl trimAddr (by unfold eaddrM; seg_norm; decide) (by decide) (by decide)
      (by decide) (lpins_of_img hpinR)
  · refine sdFact rfl (c + 8) (by unfold eaddrM; seg_norm; rw [add_imm _ _ 8 (by decide) (by rw [E.a4]; omega), E.a4])
      (by omega) (by omega) (by unfold tohostAddr; omega) (by omega)
  · exact sdFact rfl Vsa.Sim.DlHeap.topAddr (by unfold eaddrM; seg_norm; decide) (by decide) (by decide)
      (by decide) (by decide)
  · rw [ult_iff, BitVec.toNat_add, E.a5, E.t, Nat.mod_eq_of_lt (by omega), V.thr, ofNat_toNat_lt hthr]
    exact hbel

abbrev fepiL (sp a0 s0 r : BitVec 64) : GRegs := [(2, sp), (10, a0), (8, s0), (1, r)]

theorem fepi_facts {m : Std.ExtHashMap Nat (BitVec 8)} (hcode : PathLoaded m)
    {sp a0 s0 r : BitVec 64} {f : Nat → BitVec 8}
    (hsp : tohostAddr + 16 ≤ sp.toNat) (hsp' : sp.toNat + 32 ≤ 0x100000000)
    (hpinF : ∀ k, k < 32 → (m[sp.toNat + k]?).getD 0 = f (sp.toNat + k)) :
    ChainFacts m m (fepiL sp a0 s0 r) [wordOf f (sp.toNat + 16), wordOf f (sp.toNat + 24)] segFEpi := by
  unfold segFEpi ChainFacts
  chain_facts hcode with "VsaIris.MallocFast.path_at_"
  all_goals seg_norm
  all_goals (try simp only [List.tail_cons])
  · exact frameLoadW hsp hsp' 16 rfl rfl (by decide) (by decide) hpinF
  · exact frameLoadW hsp hsp' 24 rfl rfl (by decide) (by decide) hpinF

end VsaIris.MallocFast
