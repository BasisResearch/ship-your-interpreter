theorem mem_of_lookupN {l : List (Nat × BitVec 8)} {b : Nat} {v : BitVec 8} :
    l.lookup b = some v → (b, v) ∈ l := by
  induction l with
  | nil => intro h; cases h
  | cons p l ih =>
    intro h
    obtain ⟨k, x⟩ := p
    by_cases hk : b = k
    · subst hk; simp [List.lookup] at h; subst h; exact List.mem_cons_self
    · have : List.lookup b ((k, x) :: l) = l.lookup b := by
        simp [List.lookup, show (b == k) = false from by simpa using hk]
      rw [this] at h; exact List.mem_cons_of_mem _ (ih h)

/-- A table load's bytes are in `snpRO` when the lookup finds them. -/
theorem snpRO_mem_img {a w : Nat} (h : ∀ b ∈ accAddrs a w, (snpRO.lookup b).isSome = true) :
    ∀ b ∈ accAddrs a w, (b, snpROImg b) ∈ snpRO := by
  intro b hb
  have := h b hb
  unfold snpROImg
  cases e : snpRO.lookup b with
  | none => rw [e] at this; cases this
  | some v => exact mem_of_lookupN e

