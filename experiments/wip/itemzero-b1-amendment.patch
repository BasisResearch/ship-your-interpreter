+  | 0x8000448c, 0x80004514 => some Vsa.Sim.Code.Interp_runLoaded
+  | 0x80003354, 0x80003378 => some Vsa.Sim.Code.Eval_exprLoaded
+  | 0x800041a4, 0x8000409c => some Vsa.Sim.Code.Exec_stmtLoaded
