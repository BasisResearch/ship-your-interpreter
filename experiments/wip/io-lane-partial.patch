+    (hresid : k < g.uio.toNat + 16 ∨ g.uio.toNat + 24 ≤ k) :
+    (sfvM3 g)[k]? = (sfvM1 g)[k]? := by
+  have hres := sfv_residAddr g hg
+  show (writeLog (sfvMC g) (sfvLog3 g))[k]? = _
+  rw [writeLog_out _ _ _ (by
+    simp only [sfvLog3, OutL, hres, and_true]
